<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Sandbox: Twinkle's cookies, site data, history and settings
	     live in its container, which macOS keeps from other apps. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Downloads, and the file pickers for uploads and saving. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<!-- File › Import from Safari reads these (with Full Disk Access). -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Safari/</string>
		<string>/Library/Containers/com.apple.Safari/Data/Library/Cookies/</string>
		<string>/Library/Cookies/</string>
	</array>
	<!-- Where an unsandboxed Twinkle kept its data, moved into the
	     container at the first sandboxed launch (Migration.swift). -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/Twinkle/</string>
		<string>/Library/WebKit/dev.twinkle.Twinkle/</string>
		<string>/Library/HTTPStorages/dev.twinkle.Twinkle/</string>
		<string>/Library/HTTPStorages/dev.twinkle.Twinkle.binarycookies</string>
		<string>/Library/Caches/dev.twinkle.Twinkle/</string>
	</array>
	<!-- Test profiles (the profile argument), which must be under /tmp. -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<array>
		<string>/private/tmp/</string>
	</array>
</dict>
</plist>
